APP_ENV=development
APP_NAME=Vehicle Master Tracker
LOG_LEVEL=INFO
AUTH_ENABLED=true

DATABASE_URL=postgresql+asyncpg://vehicle_user:vehicle_password@localhost:5432/vehicle_master
CORS_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=change-this-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=VehicleTracker

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=300
OTP_MAX_ATTEMPTS=5

MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=10
EXCEL_MAX_FILE_SIZE_MB=50
